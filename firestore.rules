rules_version = '2';

// ReachTheSoul — Multi-Tenant Firestore Security Rules
// ─────────────────────────────────────────────────────
// Every data collection is scoped by orgId.
// Users carry an orgRoles map: { "org-slug": "admin" | "supervisor" | "agent" }
// Cloud Functions (Admin SDK) bypass these rules entirely.

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Primary: orgRoles map  { "org-slug": "admin" }
    function hasOrgRole(orgId) {
      let user = getUserDoc();
      return user != null
        && 'orgRoles' in user
        && user.orgRoles != null
        && orgId in user.orgRoles;
    }

    function getOrgRole(orgId) {
      return getUserDoc().orgRoles[orgId];
    }

    function isOrgMember(orgId) {
      return isSignedIn() && hasOrgRole(orgId);
    }

    function isOrgAdmin(orgId) {
      return isOrgMember(orgId) && getOrgRole(orgId) == "admin";
    }

    function isOrgAdminOrSupervisor(orgId) {
      return isOrgMember(orgId)
        && (getOrgRole(orgId) == "admin" || getOrgRole(orgId) == "supervisor");
    }

    function isPlatformAdmin() {
      return isSignedIn()
        && getUserDoc() != null
        && getUserDoc().isPlatformAdmin == true;
    }

    // For write rules — check orgId on the incoming document
    function incomingOrgId() {
      return request.resource.data.orgId;
    }

    function existingOrgId() {
      return resource.data.orgId;
    }

    // ─── Users ────────────────────────────────────────────────────
    // All authenticated users can read user docs (client-side filtering by org).
    // Users can update their own profile. Admins can update via platform admin panel.

    match /users/{userId} {
      // Any authenticated user can read any user doc.
      // Org filtering happens client-side (useUsers filters by orgRoles/orgMemberships).
      // This is safe because user docs don't contain sensitive data beyond org membership.
      allow read: if isSignedIn();

      // Users can update their own profile (limited fields)
      allow update: if isSignedIn() && request.auth.uid == userId
        // Cannot escalate own role or become platform admin
        && (!('isPlatformAdmin' in request.resource.data)
            || request.resource.data.isPlatformAdmin == resource.data.isPlatformAdmin)
        && (!('orgRoles' in request.resource.data)
            || request.resource.data.orgRoles == resource.data.orgRoles);

      // Platform admin can update any user
      allow update: if isSignedIn() && isPlatformAdmin();

      // Only self-registration or platform admin creates users
      allow create: if isSignedIn() && (
        request.auth.uid == userId  // self-registration
        || isPlatformAdmin()
      );

      allow delete: if isPlatformAdmin();
    }

    // ─── Organizations ────────────────────────────────────────────

    match /organizations/{orgId} {
      // Members can read their org
      allow read: if isSignedIn() && (
        isOrgMember(orgId)
        || isPlatformAdmin()
      );

      // Only org admin or platform admin can update
      allow update: if isSignedIn() && (
        isOrgAdmin(orgId)
        || isPlatformAdmin()
      );

      // Only platform admin or self-registration creates orgs
      allow create: if isSignedIn();
      allow delete: if isPlatformAdmin();
    }

    // ─── Org-Scoped Data Collections ──────────────────────────────
    // Pattern: members can read, admin/supervisor can write.

    match /respondents/{docId} {
      allow read:   if isSignedIn() && (isOrgMember(existingOrgId()) || isPlatformAdmin());
      allow create: if isSignedIn() && isOrgMember(incomingOrgId());
      allow update: if isSignedIn() && isOrgMember(existingOrgId());
      allow delete: if isSignedIn() && (isOrgAdminOrSupervisor(existingOrgId()) || isPlatformAdmin());
    }

    match /tickets/{docId} {
      allow read:   if isSignedIn() && (isOrgMember(existingOrgId()) || isPlatformAdmin());
      allow create: if isSignedIn() && isOrgMember(incomingOrgId());
      allow update: if isSignedIn() && isOrgMember(existingOrgId());
      allow delete: if isSignedIn() && (isOrgAdmin(existingOrgId()) || isPlatformAdmin());

      // Messages subcollection — same org scope as parent ticket
      match /messages/{msgId} {
        allow read:   if isSignedIn() && (isOrgMember(
          get(/databases/$(database)/documents/tickets/$(docId)).data.orgId
        ) || isPlatformAdmin());
        allow create: if isSignedIn() && isOrgMember(
          get(/databases/$(database)/documents/tickets/$(docId)).data.orgId
        );
        allow update: if false; // Messages are immutable
        allow delete: if isPlatformAdmin(); // Only platform admin can delete messages (org cleanup)
      }
    }

    match /categories/{docId} {
      allow read:  if isSignedIn() && (isOrgMember(existingOrgId()) || isPlatformAdmin());
      allow create: if isSignedIn() && isOrgAdmin(incomingOrgId());
      allow update: if isSignedIn() && isOrgAdmin(existingOrgId());
      allow delete: if isSignedIn() && (isOrgAdmin(existingOrgId()) || isPlatformAdmin());
    }

    match /lead_sources/{docId} {
      allow read:  if isSignedIn() && (isOrgMember(existingOrgId()) || isPlatformAdmin());
      allow create: if isSignedIn() && (
        isOrgAdmin(incomingOrgId()) || isOrgMember(incomingOrgId()) // seed on first load
      );
      allow update: if isSignedIn() && isOrgAdmin(existingOrgId());
      allow delete: if isSignedIn() && (isOrgAdmin(existingOrgId()) || isPlatformAdmin());
    }

    match /program_sources/{docId} {
      allow read:  if isSignedIn() && (isOrgMember(existingOrgId()) || isPlatformAdmin());
      allow create: if isSignedIn() && (
        isOrgAdmin(incomingOrgId()) || isOrgMember(incomingOrgId()) // seed on first load
      );
      allow update: if isSignedIn() && isOrgAdmin(existingOrgId());
      allow delete: if isSignedIn() && (isOrgAdmin(existingOrgId()) || isPlatformAdmin());
    }

    match /interaction_outcomes/{docId} {
      allow read:  if isSignedIn() && (isOrgMember(existingOrgId()) || isPlatformAdmin());
      allow create: if isSignedIn() && isOrgAdmin(incomingOrgId());
      allow update: if isSignedIn() && isOrgAdmin(existingOrgId());
      allow delete: if isSignedIn() && (isOrgAdmin(existingOrgId()) || isPlatformAdmin());
    }

    match /progress_steps/{docId} {
      allow read:  if isSignedIn() && (isOrgMember(existingOrgId()) || isPlatformAdmin());
      allow create: if isSignedIn() && (
        isOrgAdmin(incomingOrgId()) || isOrgMember(incomingOrgId()) // seed on first load
      );
      allow update: if isSignedIn() && isOrgAdmin(existingOrgId());
      allow delete: if isSignedIn() && (isOrgAdmin(existingOrgId()) || isPlatformAdmin());
    }

    // ─── Counters (ticket number sequence) ────────────────────────

    match /counters/{docId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn(); // increment on ticket creation
    }

    // ─── System Config ────────────────────────────────────────────

    match /system_config/{docId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && isPlatformAdmin();
    }

    // ─── Notifications ────────────────────────────────────────────

    match /notifications/{docId} {
      allow read:  if isSignedIn() && (resource.data.userId == request.auth.uid || isPlatformAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isPlatformAdmin());
    }

    // ─── Call Records ─────────────────────────────────────────────

    match /calls/{docId} {
      allow read:   if isSignedIn() && (isOrgMember(existingOrgId()) || isPlatformAdmin());
      allow create: if isSignedIn() && isOrgMember(incomingOrgId());
      allow update: if isSignedIn() && isOrgMember(existingOrgId());
      allow delete: if isSignedIn() && (isOrgAdmin(existingOrgId()) || isPlatformAdmin());
    }

    // ─── Presence ─────────────────────────────────────────────────

    match /presence/{userId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // ─── Catch-all: deny everything else ──────────────────────────

    // ─── Plan Change Audit Logs ───────────────────────────────────
    match /plan_change_logs/{docId} {
      allow read: if isSignedIn() && isPlatformAdmin();
      allow create: if isSignedIn() && isPlatformAdmin();
      allow update, delete: if false; // Audit logs are immutable
    }

    // ─── Subscription Cancellation / Pause Logs ───────────────────
    match /subscription_actions/{docId} {
      allow read: if isSignedIn() && (
        isOrgMember(existingOrgId()) || isPlatformAdmin()
      );
      allow create: if isSignedIn() && isOrgMember(incomingOrgId());
      allow update: if isSignedIn() && isPlatformAdmin();
      allow delete: if false; // Immutable
    }
// --- Onboarding Responses ---
    match /onboarding_responses/{userId} {
      allow read:   if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }
    // Any collection not explicitly matched is blocked.
  }
}