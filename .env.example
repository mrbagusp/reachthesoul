# Firebase Client (public — safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=reachthesoul-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=reachthesoul-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=reachthesoul-prod.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# AI Provider (server-side only — NEVER expose to client)
AI_PROVIDER=openai
AI_API_KEY=sk-your-key-here
AI_MODEL=gpt-4o-mini

# WhatsApp Webhook Verification (server-side only)
WHATSAPP_VERIFY_TOKEN=your_verify_token

# Polar Payment Gateway (server-side only)
POLAR_ACCESS_TOKEN=polar_oat_xxx
POLAR_WEBHOOK_SECRET=your_webhook_secret
POLAR_ORGANIZATION_ID=your_org_id
POLAR_PRODUCT_STARTER=product_id_starter
POLAR_PRODUCT_GROWTH=product_id_growth
POLAR_PRODUCT_ENTERPRISE=product_id_enterprise
POLAR_SANDBOX=true

# Firebase Admin (for webhook server-side operations)
FIREBASE_PROJECT_ID=reachthesoul-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@reachthesoul-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----\n"

# Admin notifications
ADMIN_WA_NUMBER=6285974773341
ADMIN_FONNTE_TOKEN=your_fonnte_token

# App URL
NEXT_PUBLIC_APP_URL=https://reachthesoul.org
